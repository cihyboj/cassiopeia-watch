<?xml version="1.0" encoding="utf-8"?>
<!--
   App settings (DataStore: paired watches, alarm drafts, preferences) are backed up so
   a reinstall/new phone keeps configuration. Crash logs are device-local diagnostics
   and are excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="crash_logs/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="crash_logs/" />
    </device-transfer>
</data-extraction-rules>
